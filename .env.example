# Required only to use OpenAI-powered analysis. The local deterministic MVP works without it.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional free local AI provider. Install Ollama separately and pull the model.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# Local SQLite database. Keep this local; never place personal data in source control.
DATABASE_URL="file:../data/agent.sqlite"

# Optional. Browser sessions are stored in this local directory, never in profile files.
PLAYWRIGHT_USER_DATA_DIR="./playwright-profile"

# Safety default is false. Set true only for a deliberate, reviewed local run.
ALLOW_BROWSER_SUBMIT=false
