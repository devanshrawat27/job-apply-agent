# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local-only career and application records
/data/profile/MASTER_PROFILE.md
/data/profile/master-profile.json
/data/profile/resumes/original/*
!/data/profile/resumes/original/.gitkeep
/data/resumes/drafts/*
!/data/resumes/drafts/.gitkeep
/data/resumes/approved/*
!/data/resumes/approved/.gitkeep
/data/applications/*
!/data/applications/.gitkeep
/data/agent.sqlite
/playwright-profile/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
